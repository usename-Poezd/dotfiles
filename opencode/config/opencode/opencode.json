{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "small_model": "openai/gpt-5.3-codex-spark",
  "default_agent": "build",
  "provider": {
    "anthropic": {
      "options": {
        "headers": {
          "Accept-Encoding": "identity"
        }
      }
    },
    "openai": {
      "options": {}
    },
    "google": {
      "name": "Google",
      "options": {}
    }
  },
  "plugin": [
    "./plugins/caveman/plugin.js"
  ],
  "lsp": true,
  "experimental": {
    "mcp_timeout": 5000
  },
  "agent": {
    "build": {
      "model": "openai/gpt-5.3-codex-spark",
      "variant": "low"
    },
    "plan": {
      "model": "openai/gpt-5.4",
      "variant": "low"
    },
    "general": {
      "model": "openai/gpt-5.4",
      "variant": "low"
    },
    "explore": {
      "model": "openai/gpt-5.3-codex-spark",
      "variant": "low"
    },
    "title": {
      "model": "openai/gpt-5.3-codex-spark",
      "variant": "low"
    },
    "summary": {
      "model": "openai/gpt-5.3-codex-spark",
      "variant": "low"
    },
    "compaction": {
      "model": "openai/gpt-5.3-codex-spark",
      "variant": "low"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "oauth": false,
      "timeout": 5000
    },
    "grep_app": {
      "type": "remote",
      "url": "https://grep.app.context7.com/mcp",
      "enabled": true,
      "oauth": false,
      "timeout": 5000
    },
    "caveman-shrink": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "caveman-shrink"
      ],
      "enabled": true
    }
  }
}
