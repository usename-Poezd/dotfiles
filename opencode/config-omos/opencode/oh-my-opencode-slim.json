  "disabled_agents": ["observer"],
  "multiplexer": {
    "type": "auto",
    "layout": "main-vertical",
    "main_pane_size": 60
  },
  "fallback": {
    "enabled": true,
    "timeoutMs": 15000,
    "retryDelayMs": 500,
    "retry_on_empty": true,
    "chains": {
      "orchestrator": ["anthropic/claude-sonnet-4-6", "google/gemini-3-flash"],
      "oracle": ["anthropic/claude-opus-4-6", "anthropic/claude-sonnet-4-6"],
      "council": ["anthropic/claude-opus-4-6", "openai/gpt-5.5-fast"],
      "librarian": ["openai/gpt-5.4-mini", "openai/gpt-5.3-codex-spark"],
      "explorer": ["openai/gpt-5.4-mini", "openai/gpt-5.3-codex-spark"],
      "designer": ["google/gemini-3-flash", "anthropic/claude-sonnet-4-6"],
      "fixer": ["openai/gpt-5.4-mini", "openai/gpt-5.3-codex-spark"]
    }
  },
  "council": {
    "default_preset": "default",
    "timeout": 300000,
    "councillor_execution_mode": "parallel",
    "councillor_retries": 1,
    "presets": {
      "default": {
        "alpha": {
          "model": "anthropic/claude-sonnet-4-6",
          "variant": "high"
        },
        "beta": {
          "model": "google/gemini-3-flash",
          "variant": "high"
        },
        "gamma": {
          "model": "openai/gpt-5.5-fast"
        }
      },
      "balanced": {
        "alpha": {
          "model": "openai/gpt-5.5-fast"
        },
        "beta": {
          "model": "google/gemini-3-flash"
        },
        "gamma": {
          "model": "anthropic/claude-opus-4-6"
        }
      }
    }
  },
  "todoContinuation": {
    "maxContinuations": 50,
    "cooldownMs": 3000,
    "autoEnable": false,
    "autoEnableThreshold": 4
  }
}
